{
  "name": "npm-dep-scanner",
  "version": "1.3.0",
  "description": "Scan a directory, detect Node.js projects, and compare dependency versions across them.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "bin": {
    "npm-dep-scanner": "bin/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "schemas"
  ],
  "keywords": [
    "npm",
    "dependencies",
    "scanner",
    "monorepo",
    "version",
    "compare",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvierd/npm-dep-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/xvierd/npm-dep-scanner/issues"
  },
  "homepage": "https://github.com/xvierd/npm-dep-scanner#readme",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picomatch": "^4.0.5",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  }
}
